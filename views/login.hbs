<style>
  #login-wrapper { width: 960px; margin: 80px auto 0; padding: 0 47px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; }
  #login-wrapper h1 { color: #316e66; font: 30px/36px "Times New Roman", Times, serif; text-transform: uppercase; margin: 0 0 24px 0; width: 580px; }
  #login-box { border: 1px solid #5a4535; padding: 36px 40px; width: 580px; box-sizing: border-box; background: #fff; }
  .login-field { display: flex; align-items: center; margin-bottom: 20px; }
  .login-field label { width: 130px; text-align: right; padding-right: 16px; font-size: 15px; font-family: "Times New Roman", Times, serif; color: #5a4535; font-weight: bold; }
  .login-field input { flex: 1; height: 32px; border: 1px solid #5a4535; border-radius: 2px; padding: 0 8px; font-size: 14px; }
  .login-actions { display: flex; align-items: center; margin-left: 146px; gap: 20px; margin-top: 10px; }
  .btn-login { padding: 8px 28px; border: 1px solid #5a4535; background: #fff; font-size: 15px; cursor: pointer; color: #5a4535; }
  .btn-login:hover { background: #f5f0e8; }
  .form-link { color: #2c9688; font-size: 14px; text-decoration: none; }
  .form-link:hover { text-decoration: underline; }
  .error-msg { color: red; margin-left: 146px; margin-bottom: 12px; font-size: 14px; }
</style>

<div id="login-wrapper">
  <h1>Login</h1>
  <div id="login-box">
    {{#if error}}
      <p class="error-msg">{{error}}</p>
    {{/if}}
    <form action="/login" method="POST">
      <div class="login-field">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="login-field">
        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required>
      </div>
      <div class="login-actions">
        <button type="submit" class="btn-login">Login</button>
        <a href="#" class="form-link">Forgot password?</a>
        <a href="/signup" class="form-link">Sign Up</a>
      </div>
    </form>
  </div>
</div>
