<div id="contents">

  <!-- Hero images -->
  <div style="display:flex; flex-direction:row; gap:10px; width:852px; margin:10px auto 10px;">
    {{#each hero.images}}
    <img src="/images/{{this.src}}" alt="{{this.alt}}"
         style="flex:1; height:250px; object-fit:cover; width:33%; border:0;">
    {{/each}}
  </div>

  <!-- Ad box -->
  <div id="adbox">
    <h1>{{hero.heading}}</h1>
    <p>{{hero.subtext}} <a href="/travel">travel packages</a></p>
  </div>

  <div id="main">

    <!-- Blog -->
    <div class="box">
      <div><div>
        <h3>Latest Blog</h3>
        <ul>
          {{#each blog}}
          <li>
            <h4><a href="/news">{{this.title}}</a></h4>
            <span>{{this.date}}</span>
            <p>{{this.excerpt}}</p>
          </li>
          {{/each}}
        </ul>
      </div></div>
    </div>

    <!-- Testimonials -->
    <div id="testimonials" class="box">
      <div><div>
        <h3>Testimonials</h3>
        <p>
          "{{testimonial.quote}}"
          <span>- <a href="/">{{testimonial.author}}</a></span>
        </p>
      </div></div>
    </div>

  </div>

  <!-- Sidebar -->
  <div id="sidebar">
    {{#each sidebar}}
    <div class="section">
      <a href="/travel"><img src="/images/{{this.image}}" alt="{{this.alt}}"></a>
    </div>
    {{/each}}
  </div>

</div>