<div id="contents">
  <div class="box">
    <div>
      <div class="body" style="padding: 20px 40px;">
        <h1>TRAVEL</h1>

        {{#each trips}}
        <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 30px 0; border-bottom: 1px solid #ccc;">
          
          <!-- Left: text content -->
          <div style="flex: 1; padding-right: 40px;">
            <h2 style="color: #2e8b7a; text-transform: uppercase; margin-bottom: 20px;">{{this.name}}</h2>
            <p style="line-height: 2;">{{this.description}}</p>
            {{!-- <table style="margin-top: 15px; line-height: 1.8;">
              <tr>
                <td style="padding-right: 20px;"><strong>Trip ID:</strong></td>
                <td>{{this.id}}</td>
              </tr>
              <tr>
                <td><strong>Length:</strong></td>
                <td>{{this.length}}</td>
              </tr>
              <tr>
                <td><strong>Start Date:</strong></td>
                <td>{{this.start}}</td>
              </tr>
              <tr>
                <td><strong>Resort:</strong></td>
                <td>{{this.resort}}</td>
              </tr>
              <tr>
                <td><strong>Per Person:</strong></td>
                <td>{{this.perPerson}}</td>
              </tr>
            </table> --}}
          </div>

          <!-- Right: image -->
          <div style="flex-shrink: 0;">
            <img src="/images/{{this.image}}" alt="{{this.name}}" style="width: 480px; height: 340px; object-fit: cover; display: block;">
          </div>

        </div>
        {{/each}}

      </div>
    </div>
  </div>
</div>